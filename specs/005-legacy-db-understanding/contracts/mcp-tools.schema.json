{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "mcp-tools.schema.json",
  "title": "Discovery MCP tools (input schemas)",
  "tools": {
    "list_tables": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema": { "type": "string", "maxLength": 128 },
        "namePattern": { "type": "string", "maxLength": 128, "description": "glob; never executed as SQL" },
        "limit": { "type": "integer", "minimum": 1, "maximum": 500, "default": 100 },
        "cursor": { "type": "string" }
      }
    },
    "describe_table": {
      "type": "object",
      "required": ["table"],
      "additionalProperties": false,
      "properties": {
        "schema": { "type": "string", "maxLength": 128 },
        "table": { "type": "string", "maxLength": 128 }
      }
    },
    "infer_table_relationships": {
      "type": "object",
      "required": ["tables"],
      "additionalProperties": false,
      "properties": {
        "tables": {
          "type": "array",
          "minItems": 1,
          "maxItems": 50,
          "items": { "type": "string", "maxLength": 257 }
        },
        "minConfidence": { "type": "number", "minimum": 0, "maximum": 1, "default": 0.7 },
        "verifyStatistically": { "type": "boolean", "default": true }
      }
    },
    "search_glossary": {
      "type": "object",
      "required": ["query"],
      "additionalProperties": false,
      "properties": {
        "query": { "type": "string", "minLength": 2, "maxLength": 200 },
        "limit": { "type": "integer", "minimum": 1, "maximum": 50, "default": 10 }
      }
    }
  },
  "notes": "All tool outputs wrap glossary text, identifiers and reasons with the zero-trust delimiters. No tool accepts raw SQL."
}
