{
  "name": "db-mcp-node",
  "version": "1.0.0",
  "description": "Read-only relational database MCP server with strict DatabaseAdapter contract and adversarial security suite",
  "author": "HenryD11703 <3680558330101@ingenieria.usac.edu.gt>",
  "repository": {
    "type": "git",
    "url": "https://github.com/HenryD11703/mcp-db.git"
  },
  "type": "module",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "files": [
    "dist/src/",
    "docs/glossary.yaml",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "bin": {
    "audit-verify": "dist/src/bin/audit-verify.js",
    "db-mcp": "dist/src/bin/db-mcp.js"
  },
  "scripts": {
    "prepublishOnly": "npm run build",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:audit": "vitest run tests/unit/audit-hasher.spec.ts tests/unit/audit-logger.spec.ts tests/unit/audit-no-raw-pii-multi-engine.spec.ts tests/unit/audit-rotation.spec.ts tests/unit/audit-verifier.spec.ts tests/unit/sql-sanitizer-for-audit.spec.ts",
    "test:limits": "vitest run tests/unit/limits",
    "test:rate-limit": "vitest run tests/unit/limits/rate-limiter.spec.ts",
    "test:approval": "vitest run tests/unit/limits/pending-approval-store.spec.ts tests/contract/approval-flow.spec.ts",
    "cli:db-mcp": "node dist/src/bin/db-mcp.js",
    "install:mcp": "node dist/src/bin/db-mcp.js install",
    "audit:verify": "tsx src/bin/audit-verify.ts",
    "test:adversarial": "vitest run tests/adversarial",
    "test:adversarial-rows": "vitest run tests/adversarial/malicious-rows.spec.ts",
    "test:contract": "vitest run tests/contract",
    "test:discovery": "vitest run tests/unit/discovery tests/unit/glossary tests/contract/mcp-discovery.spec.ts tests/contract/catalog-adapters.spec.ts tests/adversarial/discovery.spec.ts",
    "test:unit": "vitest run tests/unit",
    "test:security": "vitest run tests/unit/sql-security-guard.spec.ts tests/unit/startup-preflight-gate.spec.ts",
    "test:masking": "vitest run tests/unit/data-masking-engine.spec.ts tests/unit/zero-trust-sanitizer.spec.ts",
    "legacy-bank:up": "docker compose -f docker-compose.legacy-bank.yml up -d",
    "legacy-bank:down": "docker compose -f docker-compose.legacy-bank.yml down -v",
    "legacy-bank:seed": "tsx scripts/legacy-bank/seed-all.ts",
    "legacy-bank:validate": "tsx scripts/legacy-bank/validate.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.4",
    "better-sqlite3": "^13.0.3",
    "mssql": "^11.0.1",
    "mysql2": "^3.24.6",
    "node-sql-parser": "^5.3.6",
    "pg": "^8.13.1",
    "yaml": "^2.9.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/mssql": "^9.1.5",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "tsx": "^4.23.15",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "license": "MIT",
  "homepage": "https://github.com/HenryD11703/mcp-db#readme",
  "bugs": {
    "url": "https://github.com/HenryD11703/mcp-db/issues"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "database",
    "postgresql",
    "sqlserver",
    "read-only",
    "security"
  ]
}
